{
  "name": "@calasign/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@calasign/pdf": "workspace:*",
    "@calasign/shared": "workspace:*",
    "@electric-sql/pglite": "^0.5.10",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "pino": "^9.7.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
