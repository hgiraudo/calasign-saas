<?xml version="1.0" encoding="UTF-8"?>
<!-- Complemento de CalaSign para Outlook (MailApp, modo lectura): enviar a firmar un PDF adjunto del correo.
     Requiere Mailbox 1.8 (getAttachmentContentAsync). Word usa manifest.xml. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>f3980012-827e-49b8-b0eb-a37807d8843f</Id>
  <Version>{{OFFICE_VERSION}}</Version>
  <ProviderName>CalaSign</ProviderName>
  <DefaultLocale>es-ES</DefaultLocale>
  <DisplayName DefaultValue="CalaSign">
    <Override Locale="pt-BR" Value="CalaSign"/>
    <Override Locale="en-US" Value="CalaSign"/>
  </DisplayName>
  <Description DefaultValue="Enviá a firmar con CalaSign un PDF adjunto del correo.">
    <Override Locale="pt-BR" Value="Envie para assinatura com a CalaSign um PDF anexado ao e-mail."/>
    <Override Locale="en-US" Value="Send a PDF attachment for e-signature with CalaSign."/>
  </Description>
  <IconUrl DefaultValue="{{BASE_URL}}/integrations/office/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="{{BASE_URL}}/integrations/office/assets/icon-128.png"/>
  <SupportUrl DefaultValue="{{BASE_URL}}/developers"/>
  <AppDomains>
    <AppDomain>{{BASE_URL}}</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.8"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{BASE_URL}}/integrations/office/taskpane.html?host=outlook"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>true</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.8">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="CalaSign.ReadGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="CalaSign.ReadOpen">
                    <Label resid="Button.Label"/>
                    <Supertip>
                      <Title resid="Button.Label"/>
                      <Description resid="Button.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="{{BASE_URL}}/integrations/office/assets/icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="{{BASE_URL}}/integrations/office/assets/icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="{{BASE_URL}}/integrations/office/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="{{BASE_URL}}/integrations/office/taskpane.html?host=outlook"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="CalaSign"/>
          <bt:String id="Button.Label" DefaultValue="Enviar adjunto a firmar">
            <bt:Override Locale="pt-BR" Value="Enviar anexo para assinatura"/>
            <bt:Override Locale="en-US" Value="Send attachment for signature"/>
          </bt:String>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Tooltip" DefaultValue="Enviá un PDF adjunto de este correo a firmar con CalaSign.">
            <bt:Override Locale="pt-BR" Value="Envie um PDF anexado a este e-mail para assinatura com a CalaSign."/>
            <bt:Override Locale="en-US" Value="Send a PDF attached to this e-mail for signature with CalaSign."/>
          </bt:String>
        </bt:LongStrings>
      </Resources>
  </VersionOverrides>
</OfficeApp>
