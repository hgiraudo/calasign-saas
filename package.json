{
  "name": "calasign-saas",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @calasign/api --filter @calasign/web dev",
    "build": "pnpm -r build",
    "build:integrations": "pnpm --filter @calasign/integrations build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "qa": "bash scripts/qa.sh",
    "qa:rapido": "bash scripts/qa.sh --rapido",
    "qa:e2e": "bash scripts/qa.sh --e2e",
    "calidad": "node scripts/check-calidad.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-kms": "^3.1152.0",
    "@aws-sdk/client-ssm": "^3.1152.0",
    "@calasign/pdf": "workspace:^",
    "@modelcontextprotocol/sdk": "1.32.1",
    "tsx": "^4.23.15",
    "xml-crypto": "6.4.0"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "pkcs11js"
    ]
  }
}
