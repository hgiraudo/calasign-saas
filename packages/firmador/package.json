{
  "name": "@calasign/firmador",
  "version": "0.1.0",
  "private": true,
  "description": "Firmador CalaSign: firma con el certificado del titular (token PKCS#11, almacén de Windows o .p12) sin que la clave salga del dispositivo.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "calasign-firmador": "src/cli.ts"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "node build/bundle.mjs",
    "build:linux": "node build/build-sea.mjs linux-x64",
    "build:windows": "node build/build-sea.mjs windows-x64"
  },
  "dependencies": {
    "node-forge": "1.4.1",
    "pdf-lib": "^1.17.1"
  },
  "optionalDependencies": {
    "pkcs11js": "^2.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/node-forge": "1.3.14",
    "esbuild": "^0.25.12",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@calasign/pdf": "workspace:*"
  }
}
