{
  "name": "@calasign/sdk",
  "version": "0.1.0",
  "description": "SDK oficial de CalaSign (firma electrónica) para Node.js",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } }
  },
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-types.mjs",
    "prepack": "tsc -p tsconfig.build.json && node scripts/bundle-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@calasign/shared": "workspace:*",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
