[Unit]
Description=CalaSign: QA nocturno (qa.sh --e2e, SAST y DAST sobre main en un worktree propio)

[Service]
Type=oneshot
ExecStart=@REPO@/scripts/qa-nocturno.sh
# Que no le gane la RAM ni la CPU a las sesiones de trabajo.
Nice=10
IOSchedulingClass=idle
# QA --e2e (~20 min, techo 75) + SAST completo (~3, techo 20) + DAST activo (hasta 40, techo 60) y pasivo (~5, techo 25).
# Más que la suma de los techos de qa-nocturno.sh, para que el corte de un paso lo haga el script y quede el log.
TimeoutStartSec=200min
